# Copy to .env and adjust for local development. Never commit .env.

# --- General ---
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of accepted X-API-Key values
API_KEYS=change-me-dev-key
# Largest accepted job payload (serialized JSON bytes); larger gets 422
MAX_PAYLOAD_BYTES=65536

# --- PostgreSQL ---
POSTGRES_USER=workflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=workflow
POSTGRES_HOST=localhost
# Host port for the compose Postgres (5433 avoids clashing with a local Postgres on 5432)
POSTGRES_PORT=5433
# Optional full URL; when set it overrides the POSTGRES_* parts above.
# Example: postgresql+psycopg://workflow:change-me@localhost:5433/workflow
DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_PREFIX=jobs
REDIS_CONSUMER_GROUP=workers
# Approximate cap per stream; Postgres stays the source of truth, the sweeper repairs trims
STREAM_MAXLEN=100000

# --- Worker ---
# Jobs run concurrently per worker process (benchmarks use 1: one worker = one job at a time)
WORKER_CONCURRENCY=1
WORKER_ID=
WORKER_LEASE_SECONDS=30
# Must be smaller than WORKER_LEASE_SECONDS
WORKER_HEARTBEAT_SECONDS=10
# On SIGTERM, in-flight jobs get this long to finish before their lease is released
WORKER_SHUTDOWN_GRACE_SECONDS=30
WORKER_BLOCK_MS=2000

# --- Background maintenance loops ---
REAPER_INTERVAL_SECONDS=5
SWEEPER_INTERVAL_SECONDS=15
SCHEDULER_INTERVAL_SECONDS=1
# A queued job untouched this long is re-XADDed; stream PEL entries idle this long are reclaimed
SWEEPER_STALE_SECONDS=30
# Rows handled per maintenance pass
MAINTENANCE_BATCH_SIZE=500
# How often a standby maintenance process retries the leader lock
MAINTENANCE_LEADER_RETRY_SECONDS=5

# --- Retries ---
RETRY_BASE_DELAY_SECONDS=1
RETRY_MAX_DELAY_SECONDS=300
DEFAULT_MAX_ATTEMPTS=5

# --- Idempotency ---
IDEMPOTENCY_KEY_TTL_HOURS=24

# --- Rate limiting: execution throttle (token bucket per job type) ---
# JSON map: job_type -> {"rate": tokens_per_second, "burst": capacity}
RATE_LIMITS={"cpu": {"rate": 50, "burst": 100}, "embed_texts": {"rate": 5, "burst": 10}}

# --- Rate limiting: submission limit (token bucket per API key, 429 when exceeded) ---
SUBMIT_RATE_LIMIT_PER_SECOND=20
SUBMIT_RATE_LIMIT_BURST=40

# --- Embedding search ---
EMBED_SEARCH_MAX_K=50

# --- Embeddings (embed_texts job) ---
EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBED_DIM=384
EMBED_BATCH_SIZE=32
FASTEMBED_CACHE_DIR=.cache/fastembed

# --- Observability ---
METRICS_ENABLED=true
# Worker processes expose metrics on their own port
WORKER_METRICS_PORT=9100
OTEL_ENABLED=false
OTEL_SERVICE_NAME=workflow-engine
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
