# Copy to .env and adjust for local development. Never commit .env.

# --- General ---
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of accepted X-API-Key values
API_KEYS=change-me-dev-key

# --- PostgreSQL ---
POSTGRES_USER=workflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=workflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://workflow:change-me@localhost:5432/workflow
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_PREFIX=jobs
REDIS_CONSUMER_GROUP=workers

# --- Worker ---
WORKER_CONCURRENCY=4
WORKER_ID=
WORKER_LEASE_SECONDS=30
WORKER_HEARTBEAT_SECONDS=10
WORKER_SHUTDOWN_GRACE_SECONDS=30
WORKER_BLOCK_MS=2000

# --- Background maintenance loops ---
REAPER_INTERVAL_SECONDS=5
SWEEPER_INTERVAL_SECONDS=15
SCHEDULER_INTERVAL_SECONDS=1

# --- Retries ---
RETRY_BASE_DELAY_SECONDS=1
RETRY_MAX_DELAY_SECONDS=300
DEFAULT_MAX_ATTEMPTS=5

# --- Idempotency ---
IDEMPOTENCY_KEY_TTL_HOURS=24

# --- Rate limiting (token bucket per job type) ---
# JSON map: job_type -> {"rate": tokens_per_second, "burst": capacity}
RATE_LIMITS={"cpu": {"rate": 50, "burst": 100}, "embed_texts": {"rate": 5, "burst": 10}}

# --- Embeddings (embed_texts job) ---
EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBED_DIM=384
EMBED_BATCH_SIZE=32
FASTEMBED_CACHE_DIR=.cache/fastembed

# --- Observability ---
METRICS_ENABLED=true
# Worker processes expose metrics on their own port
WORKER_METRICS_PORT=9100
OTEL_ENABLED=false
OTEL_SERVICE_NAME=workflow-engine
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
