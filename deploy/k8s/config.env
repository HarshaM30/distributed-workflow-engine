APP_ENV=kind
LOG_LEVEL=INFO
LOG_JSON=true
API_HOST=0.0.0.0
API_PORT=8000
MAX_PAYLOAD_BYTES=65536
POSTGRES_USER=workflow
POSTGRES_DB=workflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
REDIS_URL=redis://redis:6379/0
REDIS_STREAM_PREFIX=jobs
REDIS_CONSUMER_GROUP=workers
STREAM_MAXLEN=100000
WORKER_CONCURRENCY=1
WORKER_ID=
WORKER_LEASE_SECONDS=15
WORKER_HEARTBEAT_SECONDS=5
# terminationGracePeriodSeconds in worker.yaml must stay above this (it is 45)
WORKER_SHUTDOWN_GRACE_SECONDS=30
WORKER_BLOCK_MS=2000
REAPER_INTERVAL_SECONDS=2
SWEEPER_INTERVAL_SECONDS=10
SCHEDULER_INTERVAL_SECONDS=1
SWEEPER_STALE_SECONDS=20
MAINTENANCE_BATCH_SIZE=500
MAINTENANCE_LEADER_RETRY_SECONDS=5
RETRY_BASE_DELAY_SECONDS=1
RETRY_MAX_DELAY_SECONDS=60
DEFAULT_MAX_ATTEMPTS=5
IDEMPOTENCY_KEY_TTL_HOURS=24
RATE_LIMITS={"cpu": {"rate": 50, "burst": 100}, "embed_texts": {"rate": 5, "burst": 10}}
# Raised so the load script (benchmarks/run_k8s.py) is never limited by the submit bucket
SUBMIT_RATE_LIMIT_PER_SECOND=1000
SUBMIT_RATE_LIMIT_BURST=2000
EMBED_SEARCH_MAX_K=50
EMBED_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBED_DIM=384
EMBED_BATCH_SIZE=32
EMBED_THREADS=2
FASTEMBED_CACHE_DIR=/app/.cache/fastembed
METRICS_ENABLED=true
WORKER_METRICS_PORT=9100
MAINTENANCE_METRICS_PORT=9101
OTEL_ENABLED=false
OTEL_SERVICE_NAME=workflow-engine
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
